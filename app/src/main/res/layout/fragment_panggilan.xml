<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/goclass_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="@dimen/content_bottom_safe">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="124dp"
            android:background="@drawable/bg_header_cinematic"
            android:paddingHorizontal="@dimen/screen_horizontal"
            android:paddingVertical="@dimen/space_lg">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="RUANG GURU"
                    android:textColor="@color/goclass_blue_100"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_2xs"
                    android:text="Panggilan masuk"
                    android:textColor="@color/white"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_2xs"
                    android:text="Permintaan siswa akan muncul di bawah."
                    android:textColor="@color/goclass_blue_100"
                    android:textSize="12sp" />
            </LinearLayout>

            <ImageView
                android:layout_width="@dimen/touch_target"
                android:layout_height="@dimen/touch_target"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_header_icon"
                android:contentDescription="@null"
                android:padding="12dp"
                android:src="@drawable/ic_bell"
                app:tint="@color/white" />
        </RelativeLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/screen_horizontal">

            <TextView
                android:id="@+id/tvLabelMenunggu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:layout_marginBottom="@dimen/space_xs"
                android:text="MENUNGGU KEHADIRAN"
                android:textColor="@color/goclass_danger"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <androidx.cardview.widget.CardView
                android:id="@+id/cvKartuPanggilan"
                style="@style/Widget.GoClass.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/space_md">

                    <ImageView
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_teacher_avatar"
                        android:contentDescription="@null"
                        android:padding="10dp"
                        android:src="@drawable/ic_bell"
                        app:tint="@color/goclass_blue_700" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_sm"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvKelasPemanggil"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Kelas XII RPL 2"
                            android:textAppearance="@style/TextAppearance.GoClass.CardTitle" />

                        <TextView
                            android:id="@+id/tvWaktuPanggilan"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_2xs"
                            android:text="Waktu: 08:00 (baru saja)"
                            android:textAppearance="@style/TextAppearance.GoClass.Meta" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnOtw"
                        style="@style/Widget.GoClass.Button.Primary"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/touch_target"
                        android:layout_marginStart="@dimen/space_xs"
                        android:text="Menuju kelas"
                        app:icon="@drawable/ic_send"
                        app:iconSize="16dp"
                        app:iconTint="@color/white" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>

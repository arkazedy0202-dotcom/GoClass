<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/goclass_background">

    <LinearLayout
        android:id="@+id/riwayatHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_horizontal"
        android:paddingTop="@dimen/screen_top"
        android:paddingEnd="@dimen/screen_horizontal"
        android:paddingBottom="@dimen/space_md"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Aktivitas"
            android:textAppearance="@style/TextAppearance.GoClass.Eyebrow" />

        <TextView
            android:id="@+id/tvJudulHalaman"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Riwayat aktivitas"
            android:textAppearance="@style/TextAppearance.GoClass.PageTitle" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:text="PANGGILAN SELESAI"
            android:textAppearance="@style/TextAppearance.GoClass.Section" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvRiwayat"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingTop="@dimen/space_2xs"
        android:paddingBottom="@dimen/content_bottom_safe"
        android:layoutAnimation="@anim/layout_stagger_fade_up"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/riwayatHeader" />

    <TextView
        android:id="@+id/tvRiwayatKosong"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:gravity="center"
        android:padding="@dimen/space_2xl"
        android:text="Belum ada aktivitas panggilan yang tercatat."
        android:textAlignment="center"
        android:textAppearance="@style/TextAppearance.GoClass.Body"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/riwayatHeader" />

</androidx.constraintlayout.widget.ConstraintLayout>
